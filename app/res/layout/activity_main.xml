<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==================== 顶部渐变头部 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="26dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AppTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name" />

                    <TextView
                        style="@style/AppSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动跳过页面 · 不联网 · 无常驻通知" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== 主体 ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="30dp">

            <!-- ========== 状态卡 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_bad" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="正在检测服务状态…"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStatusHint"
                        style="@style/HintText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnA11y"
                style="@style/BtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="打开系统无障碍设置" />

            <!-- ========== 拦截方式 ========== -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跳过之后去哪儿" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioGroup
                    android:id="@+id/rgMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbExit"
                        style="@style/RadioRow"
                        android:text="退回上一页（推荐）" />

                    <View style="@style/Divider" />

                    <RadioButton
                        android:id="@+id/rbHome"
                        style="@style/RadioRow"
                        android:text="直接回桌面" />
                </RadioGroup>
            </LinearLayout>

            <TextView
                style="@style/HintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:text="「退回上一页」：在群里点开就回到群聊。两种方式都会先按一次返回，所以重新打开不会又落回去。" />

            <!-- ========== 行为选项 ========== -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="行为选项" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <Switch
                    android:id="@+id/cbVibrate"
                    style="@style/SwitchRow"
                    android:text="跳过时震动一下" />

                <View style="@style/Divider" />

                <Switch
                    android:id="@+id/cbToast"
                    style="@style/SwitchRow"
                    android:text="跳过时显示「已跳过」" />

                <View style="@style/Divider" />

                <Switch
                    android:id="@+id/cbContent"
                    style="@style/SwitchRow"
                    android:text="内容兜底检测" />

                <View style="@style/Divider" />

                <Switch
                    android:id="@+id/cbForeground"
                    style="@style/SwitchRow"
                    android:text="后台常驻（会多一条通知）" />
            </LinearLayout>

            <TextView
                style="@style/HintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:text="内容兜底：类名认不出时按页面特征判断，偶尔会误判。后台常驻：默认关，只有服务老被系统杀掉时才需要打开。" />

            <!-- ========== 运行情况 ========== -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行情况" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="15dp">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="累计跳过次数" />

                    <TextView
                        android:id="@+id/tvBlocked"
                        style="@style/RowValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0" />
                </LinearLayout>

                <View style="@style/Divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="15dp">

                    <TextView
                        style="@style/RowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最近命中" />

                    <TextView
                        android:id="@+id/tvLast"
                        style="@style/HintText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="暂无" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnDiag"
                style="@style/BtnPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="查看 / 复制诊断信息" />

            <Button
                android:id="@+id/btnWeChat"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="打开微信试一下" />

            <Button
                android:id="@+id/btnPin"
                style="@style/BtnSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="修改管理密码" />

            <!-- ========== 高级 ========== -->
            <TextView
                style="@style/SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高级 · 深度锁定" />

            <LinearLayout
                style="@style/Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/tvDeep"
                    style="@style/HintText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="深度锁定状态：未知" />

                <Button
                    android:id="@+id/btnLock"
                    style="@style/BtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="Shizuku 一键深度锁定" />

                <Button
                    android:id="@+id/btnAdb"
                    style="@style/BtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="用电脑 adb 深度锁定" />

                <Button
                    android:id="@+id/btnUnlock"
                    style="@style/BtnSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="解除深度锁定" />
            </LinearLayout>

            <TextView
                style="@style/HintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="4dp"
                android:text="把相关页面从系统层面禁用，重启 / 微信升级 / 卸载本应用都不解除。注意：部分华为、荣耀机型不允许这样改，会直接失败 —— 不影响上面的跳过服务。" />

            <Button
                android:id="@+id/btnHelp"
                style="@style/BtnFlat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="使用说明 / 常见问题" />

            <TextView
                style="@style/HintText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="跳广告 v1.5 · 由大肥鱼生成 · 不联网，不上传任何数据" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
